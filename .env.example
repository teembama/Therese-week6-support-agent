# Copy to .env and fill in the secrets. .env is gitignored; never commit real values.
# Secrets are left EMPTY here. Settings show their safe default; an empty setting means "use the default".

# ---- Required secrets ------------------------------------------------------------------
# Supabase project URL (https://<ref>.supabase.co). Used by backend, MCP server, db and scripts.
SUPABASE_URL=
# Supabase service-role/secret key. Server-side only: it bypasses RLS. The code refuses anon/publishable keys.
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic API key for the Claude Agent SDK. Passed to the Claude Code CLI only, never to the MCP server.
ANTHROPIC_API_KEY=
# Path token for POST /v/<token>/chat/completions (D26). At least 32 URL-safe chars [A-Za-z0-9._~-]. Rotate after demos.
VAPI_LLM_SECRET=

# ---- Backend settings --------------------------------------------------------------------
# HTTP port the backend listens on.
PORT=8787

# ---- Test-only knobs: leave at defaults in production ------------------------------------------
# First-token timeout in ms before the fallback line is spoken (default 8000).
RELAYPAY_FIRST_TOKEN_TIMEOUT_MS=8000
# Hard cap per turn in ms; the agent run is aborted at this point (default 20000).
RELAYPAY_TURN_HARD_CAP_MS=20000
# At most this many agent turns run at once per process; beyond it callers hear the busy line (default 3, D59).
RELAYPAY_MAX_CONCURRENT_TURNS=3
# Override the MCP server entry file (empty = mcp-server/dist/main.js).
RELAYPAY_MCP_ENTRY=

# ---- Dev scripts (backend/src/dev/handshake.ts) -------------------------------------------------
# maxTurns for the handshake script.
HANDSHAKE_MAX_TURNS=2
# "<wrapper.mjs> <logfile>" to run the MCP server through a diagnostic wrapper (empty = off).
HANDSHAKE_MCP_WRAPPER=

# ---- Set by the backend per turn, NOT in .env (listed for completeness; mcp-server reads them) ----
# CONVERSATION_ID=   the Vapi call.id, passed to the MCP server at spawn (D9)
# TURN_INDEX=        the turn number, passed to the MCP server at spawn (D9)

# ---- Shell environment only, NOT loaded from .env (db/tests/*.sh, local Postgres tests) ------
# PG_BIN=            directory containing initdb/pg_ctl/psql (auto-detected if unset)
# TEST_PG_HOST=localhost   must be localhost/127.0.0.1/::1; anything else is refused
# TEST_PG_PORT=54329       54330 for race.sh

# Agent model (D49, docs/model-choice.md). The model comes ONLY from here; the fallback is used
# once per turn, only when the primary is reported unavailable / retired / not found.
AGENT_MODEL=claude-haiku-4-5
AGENT_MODEL_FALLBACK=claude-sonnet-5-5

# Vapi Web SDK (the browser page at /, served via /config). Public by design, but kept out of
# the repo. Restrict the key in the Vapi dashboard: your assistant only, transient assistants
# OFF, allowed origin = the deployed https origin.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
# Login (D86): the Supabase PUBLISHABLE key (public, browser Auth only) and the enforcement flag.
SUPABASE_PUBLISHABLE_KEY=
CUSTOMER_LOGIN_REQUIRED=0
# Staff dashboard (D87): /staff, staff accounts only. Off by default.
STAFF_DASHBOARD_ENABLED=0
# Optional (D83): Discord webhook for team notifications. Unset = sender off, outbox rows stay pending.
DISCORD_WEBHOOK_URL=
