{
  "name": "relaypay-support-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "backend",
    "mcp-server",
    "db",
    "scripts"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:seed": "npm run seed -w @relaypay/db",
    "db:verify": "npm run verify-seed -w @relaypay/scripts",
    "db:test": "bash db/tests/schema-suite.sh && bash db/tests/race.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
